<Window x:Class="LoboEstepario.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lobo Estepario · Prospección &amp; CRM"
        Icon="Images/LoboEstepario_Logotipo.jpg"
        Width="1360" Height="860" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="264"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar fija de 264 px -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="16,22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Marca -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="6,4,6,20" Margin="0,0,0,18">
          <StackPanel Orientation="Horizontal">
            <Border Width="42" Height="42" CornerRadius="12" Effect="{StaticResource GoldGlow}">
              <Border.Background>
                <ImageBrush ImageSource="Images/LoboEstepario_Logotipo.jpg" Stretch="UniformToFill"/>
              </Border.Background>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Lobo Estepario" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="DESKTOP · PROSPECCIÓN" FontSize="10.5" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Navegación (se genera desde MainWindow.xaml.cs en el orden de la web) -->
        <StackPanel x:Name="NavPanel" Grid.Row="1"/>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="8,14,8,4">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource GoldBrush}" VerticalAlignment="Center">
              <Ellipse.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#E4A53C" Opacity="1"/>
              </Ellipse.Effect>
            </Ellipse>
            <TextBlock Text="API LoboEstepario" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource FaintBrush}"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Área principal -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="64"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Resplandores de fondo, como el body de app.css -->
      <Rectangle Grid.RowSpan="2" Fill="{StaticResource GlowVioletBrush}" IsHitTestVisible="False"/>
      <Rectangle Grid.RowSpan="2" Fill="{StaticResource GlowGoldBrush}" IsHitTestVisible="False"/>

      <!-- Topbar de 64 px -->
      <Border Grid.Row="0" Background="#B807090D" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="28,0">
        <DockPanel>
          <Border x:Name="StatusPill" DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="999" Padding="13,6"
                  Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
              <TextBlock x:Name="StatusText" Text="Comprobando API…" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </Border>
          <TextBlock Text="Prospección &amp; CRM" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSoftBrush}"/>
        </DockPanel>
      </Border>

      <!-- Contenido -->
      <ScrollViewer Grid.Row="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ContentControl x:Name="PageHost" Margin="28" MaxWidth="1380" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                        IsTabStop="False"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
