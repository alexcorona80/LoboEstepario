<Border Grid.Row="2" Background="{StaticResource NightRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="14,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource GoldBrush}" Margin="0,0,8,0"/><TextBlock Text="API LOCAL" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="Fichero local listo" Foreground="{StaticResource FaintBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel></Border>
</Grid></Border></Window>
