<Window x:Class="LoboEstepario.SocialWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lobo Estepario · Redes sociales" Height="860" Width="1340" MinHeight="640" MinWidth="1060" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource NightBrush}" Foreground="{StaticResource TextBrush}">
<Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="31"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="{StaticResource NightRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><DockPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0"><TextBlock Text="◉" Foreground="{StaticResource GoldBrush}" FontSize="17"/><TextBlock Text="LOBO ESTEPARIO" Foreground="{StaticResource GoldBrush}" FontSize="10" Margin="10,0"/><Border Width="1" Height="14" Background="{StaticResource LineBrush}" Margin="4,0,10,0"/><TextBlock Text="REDES SOCIALES" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="—" Click="Minimize_Click" Width="46" BorderThickness="0" Padding="0"/><Button Content="×" Click="Close_Click" Width="46" BorderThickness="0" Padding="0"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource EmberBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Button.Style></Button></StackPanel></DockPanel></Border>
<Grid Grid.Row="1" Margin="22,18,22,14"><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel Margin="18,16,18,14"><TextBlock Text="DESTINATARIOS" Foreground="{StaticResource GoldBrush}" FontSize="10"/><TextBlock Text="Empresas con correo" FontFamily="Georgia" FontSize="23" Margin="0,8,0,16"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBox x:Name="RecipientSearchBox" Grid.Column="0" Height="34" VerticalContentAlignment="Center" Padding="10,0" TextChanged="RecipientSearchBox_TextChanged" ToolTip="Filtrar por empresa, correo o ubicación"/>
<Button Grid.Column="1" Content="TODOS" Click="SelectAll_Click" Margin="8,0,0,0" Padding="12,8" Height="34" VerticalContentAlignment="Center"/>
</Grid></StackPanel>
<DockPanel Grid.Row="1" Margin="18,0,18,8"><TextBlock x:Name="RecipientCount" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="SELECTIVOS PARA EL CORREO" Foreground="{StaticResource FaintBrush}" FontSize="10"/></DockPanel>
<DataGrid x:Name="RecipientsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" RowHeaderWidth="0" SelectionMode="Single"><DataGrid.Columns>
<DataGridCheckBoxColumn Header="" Width="42" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
<DataGridTextColumn Header="EMPRESA" IsReadOnly="True" Binding="{Binding Name}" Width="*"/>
<DataGridTextColumn Header="CORREO" IsReadOnly="True" Binding="{Binding Email}" Width="1.4*"/>
<DataGridTextColumn Header="UBICACIÓN" IsReadOnly="True" Binding="{Binding Location}" Width="1.1*"/>
</DataGrid.Columns></DataGrid>
</Grid></Border>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20,16,20,18" Margin="0,0,0,14"><StackPanel>
<TextBlock Text="NUEVA PUBLICACIÓN" Foreground="{StaticResource GoldBrush}" FontSize="10"/><TextBlock Text="Crea, genera y publica" FontFamily="Georgia" FontSize="23" Margin="0,8,0,16"/>
<TextBlock Text="TEMA DE LA PUBLICACIÓN" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="TopicBox" Height="37" Margin="0,6,0,14" VerticalContentAlignment="Center" Padding="12,0" ToolTip="El tema del que tratará la publicación, la imagen y el correo"/>
<StackPanel Orientation="Horizontal"><TextBlock Text="PUBLICAR EN / ENVIAR POR:" Foreground="{StaticResource FaintBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/><CheckBox x:Name="UseFacebookBox" Content="Facebook" Foreground="{StaticResource TextBrush}" IsChecked="True" Margin="0,0,14,0"/><CheckBox x:Name="UseInstagramBox" Content="Instagram" Foreground="{StaticResource TextBrush}" IsChecked="True" Margin="0,0,14,0"/><CheckBox x:Name="UseEmailBox" Content="Correo electrónico" Foreground="{StaticResource TextBrush}" IsChecked="True"/></StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="GenerateButton" Content="GENERAR IMAGEN Y TEXTO" Click="Generate_Click" Margin="0,0,8,0" Padding="16,10"/><Button x:Name="PublishButton" Content="PUBLICAR" Click="Publish_Click" Margin="0,0,8,0" Padding="16,10"/><Button x:Name="EmailButton" Content="ENVIAR POR CORREO" Click="Email_Click" Padding="16,10"/></StackPanel>
</StackPanel></Border>
<Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="CONTENIDO GENERADO" Foreground="{StaticResource GoldBrush}" FontSize="10" Margin="20,16,20,0"/>
<Grid Grid.Row="1" Margin="20,8,20,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource NightRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Width="300" Height="210" Padding="8"><Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
<StackPanel Grid.Column="2">
<TextBlock Text="TEXTO (editable)" Foreground="{StaticResource FaintBrush}" FontSize="10"/>
<TextBox x:Name="ContentBodyBox" Style="{StaticResource MultilineTextBox}" AcceptsReturn="True" MinHeight="120" Margin="0,6,0,12" ToolTip="Texto de la publicación; ajústalo antes de publicar o enviar"/>
<TextBlock Text="URL PÚBLICA DE LA IMAGEN (solo Instagram)" Foreground="{StaticResource FaintBrush}" FontSize="10"/>
<TextBlock Text="Instagram descarga la imagen por URL pública; Facebook y el correo usan la imagen generada localmente." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,6"/>
<TextBox x:Name="PublicImageUrlBox" Height="70" VerticalContentAlignment="Top" Padding="10,8" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Dirección https accesible públicamente de la imagen si vas a publicar en Instagram"/>
</StackPanel>
</Grid>
</Grid></Border>
</Grid>
</Grid>
<Border Grid.Row="2" Background="{StaticResource NightRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="14,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource GoldBrush}" Margin="0,0,8,0"/><TextBlock Text="REDES SOCIALES" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="Conectando con la API local…" Foreground="{StaticResource FaintBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel></Border>
</Grid></Border>
</Window>