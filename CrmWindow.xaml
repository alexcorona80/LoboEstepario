<Window x:Class="LoboEstepario.CrmWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lobo Estepario · CRM" Height="860" Width="1280" MinHeight="640" MinWidth="1020" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource NightBrush}" Foreground="{StaticResource TextBrush}">
<Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="31"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="{StaticResource NightRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><DockPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0"><TextBlock Text="◉" Foreground="{StaticResource GoldBrush}" FontSize="17"/><TextBlock Text="LOBO ESTEPARIO" Foreground="{StaticResource GoldBrush}" FontSize="10" Margin="10,0"/><Border Width="1" Height="14" Background="{StaticResource LineBrush}" Margin="4,0,10,0"/><TextBlock Text="CRM · CORREO" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="—" Click="Minimize_Click" Width="46" BorderThickness="0" Padding="0"/><Button Content="×" Click="Close_Click" Width="46" BorderThickness="0" Padding="0"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource EmberBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Button.Style></Button></StackPanel></DockPanel></Border>
<Grid Grid.Row="1" Margin="22,18,22,14"><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel Margin="18,16,18,14"><TextBlock Text="DESTINATARIOS" Foreground="{StaticResource GoldBrush}" FontSize="10"/><TextBlock Text="Empresas con correo" FontFamily="Georgia" FontSize="23" Margin="0,8,0,16"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBox x:Name="RecipientSearchBox" Grid.Column="0" Height="34" VerticalContentAlignment="Center" Padding="10,0" TextChanged="RecipientSearchBox_TextChanged" ToolTip="Filtrar por empresa, correo o ubicación"/>
<Button Grid.Column="1" Content="TODOS" Click="SelectAll_Click" Margin="8,0,0,0" Padding="12,8" Height="34" VerticalContentAlignment="Center"/>
</Grid></StackPanel>
<DockPanel Grid.Row="1" Margin="18,0,18,8"><TextBlock x:Name="RecipientCount" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="EMPRESAS CON CORREO REGISTRADO" Foreground="{StaticResource FaintBrush}" FontSize="10"/></DockPanel>
<DataGrid x:Name="RecipientsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" RowHeaderWidth="0" SelectionMode="Single"><DataGrid.Columns>
<DataGridCheckBoxColumn Header="" Width="42" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
<DataGridTextColumn Header="EMPRESA" IsReadOnly="True" Binding="{Binding Name}" Width="*"/>
<DataGridTextColumn Header="CORREO" IsReadOnly="True" Binding="{Binding Email}" Width="1.4*"/>
<DataGridTextColumn Header="UBICACIÓN" IsReadOnly="True" Binding="{Binding Location}" Width="1.1*"/>
</DataGrid.Columns></DataGrid>
</Grid></Border>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20,16,20,18" Margin="0,0,0,14"><StackPanel>
<TextBlock Text="CUENTA DE CORREO" Foreground="{StaticResource GoldBrush}" FontSize="10"/><TextBlock Text="Configura el remitente" FontFamily="Georgia" FontSize="21" Margin="0,8,0,16"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12"><TextBlock Text="PROVEEDOR" Foreground="{StaticResource FaintBrush}" FontSize="10"/><ComboBox x:Name="ProviderBox" Height="35" Margin="0,8,0,0" Padding="10,0" SelectionChanged="ProviderBox_SelectionChanged"><ComboBoxItem Content="Gmail"/><ComboBoxItem Content="Outlook / Microsoft 365"/><ComboBoxItem Content="Yahoo"/><ComboBoxItem Content="Otro (personalizado)"/></ComboBox></StackPanel>
<StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,12"><TextBlock Text="HOST SMTP" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="SmtpHostBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0"/></StackPanel>
<StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="PUERTO" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="SmtpPortBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0"/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12"><TextBlock Text="USUARIO (CORREO REMITENTE)" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="SmtpUserBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0"/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,12"><TextBlock Text="NOMBRE DEL REMITENTE" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="FromNameBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0"/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="CONTRASEÑA" Foreground="{StaticResource FaintBrush}" FontSize="10"/><PasswordBox x:Name="SmtpPasswordBox" Height="35" Margin="0,8,0,0" Padding="10,0"/></StackPanel>
<TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,42,0,0"><CheckBox x:Name="UseSslBox" Content="Usar SSL / TLS" Foreground="{StaticResource TextBrush}"/></TextBlock>
<StackPanel Grid.Row="1" Grid.Column="2" Margin="0,52,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="GUARDAR CUENTA" Click="SaveAccount_Click" Margin="0,0,8,0"/><Button Content="PROBAR ENVÍO" Click="SendTest_Click"/></StackPanel></StackPanel>
</Grid></StackPanel></Border>
<Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20,16,20,18" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="NUEVO CORREO" Foreground="{StaticResource GoldBrush}" FontSize="10"/><TextBlock Grid.Row="1" Text="Redacta el mensaje" FontFamily="Georgia" FontSize="21" Margin="0,8,0,14"/>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<TextBox x:Name="SubjectBox" Grid.Row="0" Grid.Column="0" Height="37" VerticalContentAlignment="Center" Padding="12,0" Margin="0,0,10,12" ToolTip="Asunto del correo"/>
<TextBlock x:Name="SelectedCountLabel" Grid.Row="0" Grid.Column="1" Foreground="{StaticResource GoldBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,12"/>
<TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Cuerpo del mensaje · usa {Empresa} para personalizar con el nombre del negocio" Foreground="{StaticResource FaintBrush}" FontSize="10" Margin="0,0,0,8"/>
<TextBox x:Name="BodyBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource MultilineTextBox}" AcceptsReturn="True" MinHeight="150" ToolTip="Cuerpo del correo"/>
</Grid></Grid></Border>
<Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel Margin="18,14,18,8"><TextBlock Text="HISTORIAL DE ENVÍOS" Foreground="{StaticResource FaintBrush}" FontSize="10" VerticalAlignment="Center"/><TextBlock x:Name="StatsText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel>
<DockPanel Grid.Row="1" Margin="18,0,18,8"><TextBlock Text="Últimos correos enviados por el CRM" Foreground="{StaticResource FaintBrush}" FontSize="10"/><Button x:Name="SendButton" DockPanel.Dock="Right" Content="ENVIAR A LOS SELECCIONADOS" Click="SendEmails_Click" Margin="0,0,0,0" Padding="16,8"/></DockPanel>
<DataGrid x:Name="HistoryGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns>
<DataGridTextColumn Header="EMPRESA" Binding="{Binding BusinessName}" Width="*"/>
<DataGridTextColumn Header="CORREO" Binding="{Binding ToEmail}" Width="1.3*"/>
<DataGridTextColumn Header="ASUNTO" Binding="{Binding Subject}" Width="1.6*"/>
<DataGridTextColumn Header="ENVÍO" Binding="{Binding SentAt}" Width="*"/>
<DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" Width="*"/>
</DataGrid.Columns></DataGrid>
</Grid></Border>
</Grid>
</Grid>
<Border Grid.Row="2" Background="{StaticResource NightRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="14,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource GoldBrush}" Margin="0,0,8,0"/><TextBlock Text="CRM · CORREO" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="Conectando con la API local…" Foreground="{StaticResource FaintBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel></Border>
</Grid></Border>
</Window>