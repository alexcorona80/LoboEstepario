<Window x:Class="LoboEstepario.ConfigWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lobo Estepario · Configuración" Height="880" Width="1120" MinHeight="640" MinWidth="900" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource NightBrush}" Foreground="{StaticResource TextBrush}">
<Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="31"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="{StaticResource NightRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><DockPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0"><TextBlock Text="◉" Foreground="{StaticResource GoldBrush}" FontSize="17"/><TextBlock Text="LOBO ESTEPARIO" Foreground="{StaticResource GoldBrush}" FontSize="10" Margin="10,0"/><Border Width="1" Height="14" Background="{StaticResource LineBrush}" Margin="4,0,10,0"/><TextBlock Text="CONFIGURACIÓN" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="—" Click="Minimize_Click" Width="46" BorderThickness="0" Padding="0"/><Button Content="×" Click="Close_Click" Width="46" BorderThickness="0" Padding="0"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource EmberBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Button.Style></Button></StackPanel></DockPanel></Border>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="1080" Margin="36,26,36,34" HorizontalAlignment="Center">
<StackPanel><TextBlock Text="AJUSTES DE LA CUENTA" Foreground="{StaticResource GoldBrush}" FontSize="10"/><TextBlock FontFamily="Georgia" FontSize="32" Margin="0,10,0,0"><Run Text="Configuración del "/><Run Foreground="{StaticResource GoldLightBrush}" FontStyle="Italic" Text="escritorio."/></TextBlock><Border Width="64" Height="2" Background="{StaticResource GoldBrush}" HorizontalAlignment="Left" Margin="0,16,0,0"/><TextBlock Text="Correo electrónico, Facebook e Instagram. Estos datos alimentan el CRM y el módulo de redes sociales." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,14,0,24"/></StackPanel>
<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="22,18" Margin="0,0,0,16"><StackPanel>
<TextBlock Text="CORREO ELECTRÓNICO" Foreground="{StaticResource GoldBrush}" FontSize="10"/><TextBlock Text="Configura el remitente" FontFamily="Georgia" FontSize="22" Margin="0,8,0,16"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12"><TextBlock Text="PROVEEDOR" Foreground="{StaticResource FaintBrush}" FontSize="10"/><ComboBox x:Name="ProviderBox" Height="35" Margin="0,8,0,0" Padding="10,0" SelectionChanged="ProviderBox_SelectionChanged"><ComboBoxItem Content="Gmail"/><ComboBoxItem Content="Outlook / Microsoft 365"/><ComboBoxItem Content="Yahoo"/><ComboBoxItem Content="Otro (personalizado)"/></ComboBox></StackPanel>
<StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,12"><TextBlock Text="HOST SMTP" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="SmtpHostBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0"/></StackPanel>
<StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="PUERTO" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="SmtpPortBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0"/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12"><TextBlock Text="USUARIO (CORREO REMITENTE)" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="SmtpUserBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0"/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,12"><TextBlock Text="NOMBRE DEL REMITENTE" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="FromNameBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0"/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="CONTRASEÑA" Foreground="{StaticResource FaintBrush}" FontSize="10"/><PasswordBox x:Name="SmtpPasswordBox" Height="35" Margin="0,8,0,0" Padding="10,0"/></StackPanel>
<StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox x:Name="UseSslBox" Content="Usar SSL / TLS" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/><Button x:Name="TestButton" Content="PROBAR ENVÍO" Click="SendTest_Click" Margin="0,0,8,0"/><Button Content="GUARDAR CUENTA" Click="SaveAccount_Click"/></StackPanel></StackPanel>
</Grid></StackPanel></Border>
<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="22,18" Margin="0,0,0,16"><StackPanel>
<TextBlock Text="FACEBOOK" Foreground="{StaticResource GoldBrush}" FontSize="10"/><TextBlock Text="Publicar en tu página" FontFamily="Georgia" FontSize="22" Margin="0,8,0,10"/>
<TextBlock Text="Publica texto e imágenes en una Página de Facebook con la Graph API de Meta." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.8*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12"><TextBlock Text="ID DE LA PÁGINA" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="FacebookPageIdBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0" ToolTip="El ID de tu Página de Facebook. Aparece en «Acerca de» de la página o vía GET /{page-id}."/></StackPanel>
<StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"><TextBlock Text="TOKEN DE ACCESO DE LA PÁGINA" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="FacebookTokenBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0" ToolTip="En Graph Explorer pide los permisos pages_manage_posts, pages_manage_metadata, pages_read_engagement y pages_show_list, y llama a GET /me/accounts."/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,12"><TextBlock Text="ID DE LA APP (META)" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="FacebookAppIdBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0" ToolTip="El App ID de tu app de Meta en developers.facebook.com."/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"><TextBlock Text="SECRETO DE LA APP" Foreground="{StaticResource FaintBrush}" FontSize="10"/><PasswordBox x:Name="FacebookAppSecretBox" Height="35" Margin="0,8,0,0" Padding="10,0" ToolTip="El App Secret de tu app de Meta."/></StackPanel>
<StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0"><Button Content="GUARDAR FACEBOOK" Click="SaveFacebook_Click" HorizontalAlignment="Right"/></StackPanel>
</Grid></StackPanel></Border>
<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="22,18" Margin="0,0,0,16"><StackPanel>
<TextBlock Text="INSTAGRAM" Foreground="{StaticResource GoldBrush}" FontSize="10"/><TextBlock Text="Publicar en tu cuenta de negocio" FontFamily="Georgia" FontSize="22" Margin="0,8,0,10"/>
<TextBlock Text="La cuenta de Instagram debe ser profesional (business o creator) y estar vinculada a una Página de Facebook. La API publica en 2 pasos: crea un contenedor y luego lo publica." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.8*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12"><TextBlock Text="ID DE LA CUENTA DE NEGOCIO (IG)" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="InstagramAccountIdBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0" ToolTip="ID numérico del perfil profesional de Instagram, consultable con GET /{ig-user-id}?fields=id,username."/></StackPanel>
<StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"><TextBlock Text="TOKEN DE ACCESO (FACEBOOK LOGIN)" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="InstagramTokenBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0" ToolTip="Token de usuario/página de Facebook con permisos instagram_basic, instagram_content_publish y pages_read_engagement."/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,12"><TextBlock Text="ID DE LA APP (META)" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="InstagramAppIdBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0"/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"><TextBlock Text="SECRETO DE LA APP" Foreground="{StaticResource FaintBrush}" FontSize="10"/><PasswordBox x:Name="InstagramAppSecretBox" Height="35" Margin="0,8,0,0" Padding="10,0"/></StackPanel>
<StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0"><Button Content="GUARDAR INSTAGRAM" Click="SaveInstagram_Click" HorizontalAlignment="Right"/></StackPanel>
</Grid></StackPanel></Border>
<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="22,18" Margin="0,0,0,16"><StackPanel>
<TextBlock Text="AGENTE DE IA" Foreground="{StaticResource GoldBrush}" FontSize="10"/><TextBlock Text="Genera publicaciones, imágenes y correos" FontFamily="Georgia" FontSize="22" Margin="0,8,0,10"/>
<TextBlock Text="Este agente redacta el contenido de las publicaciones de Facebook e Instagram, genera las imágenes de las publicaciones y escribe el contenido de los correos del CRM." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12"><TextBlock Text="PROVEEDOR" Foreground="{StaticResource FaintBrush}" FontSize="10"/><ComboBox x:Name="AiProviderBox" Height="35" Margin="0,8,0,0" Padding="10,0" SelectionChanged="AiProviderBox_SelectionChanged"><ComboBoxItem Tag="openai" Content="OpenAI"/><ComboBoxItem Tag="azure_openai" Content="Azure OpenAI"/><ComboBoxItem Tag="anthropic" Content="Anthropic"/><ComboBoxItem Tag="google_gemini" Content="Google Gemini"/><ComboBoxItem Tag="openai_compatible" Content="Otro (OpenAI-compatible)"/></ComboBox></StackPanel>
<StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,12"><TextBlock Text="BASE URL (OPCIONAL)" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="AiBaseUrlBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0" ToolTip="URL de la API. En blanco se usa la de cada proveedor; útil para servidores OpenAI-compatibles (por ejemplo Ollama)."/></StackPanel>
<StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="MODELO DE TEXTO" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="AiModelBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0" ToolTip="Modelo de lenguaje, p. ej. gpt-4o-mini, claude-3-5-sonnet, gemini-1.5-pro."/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12"><TextBlock Text="MODELO DE IMÁGENES" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBox x:Name="AiImageModelBox" Height="35" Margin="0,8,0,0" VerticalContentAlignment="Center" Padding="10,0" ToolTip="Modelo generador de imágenes, p. ej. dall-e-3 o gpt-image-1."/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,12"><TextBlock Text="API KEY" Foreground="{StaticResource FaintBrush}" FontSize="10"/><PasswordBox x:Name="AiApiKeyBox" Height="35" Margin="0,8,0,0" Padding="10,0" ToolTip="Clave de API del proveedor seleccionado."/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,36,0,0"><Button Content="GUARDAR AGENTE IA" Click="SaveAiAgent_Click"/></StackPanel></StackPanel>
</Grid></StackPanel></Border>
<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="22,18" Margin="0,0,0,16"><StackPanel>
<TextBlock Text="REQUISITOS PARA PUBLICAR CONTENIDO" Foreground="{StaticResource GoldBrush}" FontSize="10"/><TextBlock Text="Qué necesitas antes de publicar" FontFamily="Georgia" FontSize="22" Margin="0,8,0,16"/>
<TextBlock Text="FACEBOOK · Pages API" Foreground="{StaticResource GoldLightBrush}" FontSize="12" Margin="0,0,0,7"/>
<TextBlock Text="· Una Página de Facebook (puede estar sin publicar) sobre la que tengas rol con tarea CREATE_CONTENT." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap"/>
<TextBlock Text="· Token de acceso de Página emitido por ese rol: en Graph Explorer pide pages_manage_posts, pages_manage_metadata, pages_read_engagement y pages_show_list, y consulta GET /me/accounts." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap"/>
<TextBlock Text="· Publicar: POST /{page-id}/feed con message y access_token. Para vídeo se necesita además el permiso publish_video." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>
<TextBlock Text="INSTAGRAM · Instagram Graph API (Facebook Login)" Foreground="{StaticResource GoldLightBrush}" FontSize="12" Margin="0,0,0,7"/>
<TextBlock Text="· Cuenta de Instagram profesional (business o creator) vinculada a una Página de Facebook, con rol CREATE_CONTENT/MANAGE sobre la página." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap"/>
<TextBlock Text="· Permisos: instagram_basic, instagram_content_publish y pages_read_engagement." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap"/>
<TextBlock Text="· El archivo (imagen o vídeo) debe estar alojado en un servidor público; la API lo descarga por URL." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap"/>
<TextBlock Text="· Publicar en 2 pasos: 1) POST /{ig-user-id}/media con image_url o video_url (crea el contenedor), 2) POST /{ig-user-id}/media_publish con creation_id." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap"/>
<TextBlock Text="· Límite de publicación: 100 por cada 24 horas. Nota: el módulo de redes sociales se conectará a esta configuración." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
</StackPanel></Border>
</StackPanel></ScrollViewer>
<Border Grid.Row="2" Background="{StaticResource NightRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="14,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource GoldBrush}" Margin="0,0,8,0"/><TextBlock Text="CONFIGURACIÓN" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="Listo." Foreground="{StaticResource FaintBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel></Border>
</Grid></Border>
</Window>