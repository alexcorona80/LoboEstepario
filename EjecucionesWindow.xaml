<Window x:Class="LoboEstepario.EjecucionesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lobo Estepario · Ejecuciones" Height="760" Width="1100" MinHeight="600" MinWidth="940" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource NightBrush}" Foreground="{StaticResource TextBrush}">
<Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="31"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="{StaticResource NightRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><DockPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0"><TextBlock Text="◉" Foreground="{StaticResource GoldBrush}" FontSize="17"/><TextBlock Text="LOBO ESTEPARIO" Foreground="{StaticResource GoldBrush}" FontSize="10" Margin="10,0"/><Border Width="1" Height="14" Background="{StaticResource LineBrush}" Margin="4,0,10,0"/><TextBlock Text="EJECUCIONES · ACTIVIDAD" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="—" Click="Minimize_Click" Width="46" BorderThickness="0" Padding="0"/><Button Content="×" Click="Close_Click" Width="46" BorderThickness="0" Padding="0"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource EmberBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Button.Style></Button></StackPanel></DockPanel></Border>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="1080" Margin="36,26,36,34" HorizontalAlignment="Center">
<StackPanel><TextBlock Text="ACTIVIDAD" Foreground="{StaticResource GoldBrush}" FontSize="10"/><TextBlock FontFamily="Georgia" FontSize="32" Margin="0,10,0,0"><Run Text="Resumen de las "/><Run Foreground="{StaticResource GoldLightBrush}" FontStyle="Italic" Text="ejecuciones."/></TextBlock><Border Width="64" Height="2" Background="{StaticResource GoldBrush}" HorizontalAlignment="Left" Margin="0,16,0,0"/><TextBlock Text="Últimas prospecciones (scrape a Overture) y envíos de correo del CRM. Los detalles de cada envío se consultan en el módulo CRM." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,14,0,24"/></StackPanel>
<Grid Margin="0,0,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,9">
<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16" Margin="0,0,9,0"><StackPanel><TextBlock Text="ÚLTIMA PROSPECCIÓN" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBlock x:Name="LastScrapeValue" Text="—" FontFamily="Georgia" FontSize="23" Margin="0,7,0,0"/><TextBlock Text="se rescrapea para actualizar cada lugar" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/></StackPanel></Border>
<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16" Margin="0,0,9,0"><StackPanel><TextBlock Text="NEGOCIOS RESULTADO" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBlock x:Name="BusinessTotalValue" Text="—" FontFamily="Georgia" FontSize="27" Margin="0,3,0,0"/><TextBlock x:Name="BusinessContactValue" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border>
<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16"><StackPanel><TextBlock Text="FUENTES ACTIVAS" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBlock x:Name="ActiveSourcesValue" Text="—" FontFamily="Georgia" FontSize="27" Margin="0,3,0,0"/><TextBlock Text="geografías configuradas para prospectar" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border>
</UniformGrid>
<UniformGrid Grid.Row="1" Columns="3">
<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16" Margin="0,0,9,0"><StackPanel><TextBlock Text="ÚLTIMO ENVÍO DEL CRM" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBlock x:Name="LastEmailValue" Text="—" FontFamily="Georgia" FontSize="23" Margin="0,7,0,0"/><TextBlock Text="historial en el módulo CRM" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/></StackPanel></Border>
<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16" Margin="0,0,9,0"><StackPanel><TextBlock Text="CORREOS ENVIADOS" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBlock x:Name="EmailSentValue" Text="—" FontFamily="Georgia" FontSize="27" Margin="0,3,0,0"/><TextBlock x:Name="EmailFailedValue" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border>
<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16"><StackPanel><TextBlock Text="EMPRESAS CON CORREO" Foreground="{StaticResource FaintBrush}" FontSize="10"/><TextBlock x:Name="BusinessesWithEmailValue" Text="—" FontFamily="Georgia" FontSize="27" Margin="0,3,0,0"/><TextBlock Text="base potencial del módulo de correo" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border>
</UniformGrid>
</Grid>
<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="22,18"><StackPanel>
<TextBlock Text="¿CÓMO SE EJECUTAN LOS PROCESOS?" Foreground="{StaticResource GoldBrush}" FontSize="10"/><TextBlock Text="Flujo de trabajo actual" FontFamily="Georgia" FontSize="21" Margin="0,8,0,12"/>
<TextBlock Text="La prospección se dispara desde «Buscar negocios» con el botón de scrape: la API consulta Overture alrededor del centro y radio elegidos (hasta 100 lugares por ejecución) y persiste cada resultado en MongoDB." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
<TextBlock Text="Los correos se ejecutan desde el CRM o desde Redes sociales, y cada resultado queda registrado en el historial con su estado y fecha. Las ejecuciones automáticas programadas estarán disponibles en una próxima versión." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
</StackPanel></Border>
<Button x:Name="RefreshButton" Content="ACTUALIZAR" Click="Refresh_Click" HorizontalAlignment="Left" Margin="0,22,0,0" Padding="16,10"/>
</StackPanel></ScrollViewer>
<Border Grid.Row="2" Background="{StaticResource NightRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="14,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource GoldBrush}" Margin="0,0,8,0"/><TextBlock Text="API LOCAL" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="Cargando la actividad…" Foreground="{StaticResource FaintBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel></Border>
</Grid></Border>
</Window>