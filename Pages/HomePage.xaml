<UserControl x:Class="LoboEstepario.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <StackPanel Margin="0,0,0,24">
      <TextBlock Text="PANEL DE CONTROL" Style="{StaticResource Eyebrow}"/>
      <TextBlock Text="Inicio" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource PageLead}"
                 Text="Estado general de la prospección: la base de datos de negocios y la actividad reciente del CRM."/>
    </StackPanel>

    <Border x:Name="LoadingPanel" Style="{StaticResource EmptyState}" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="⟳" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource GoldBrush}"/>
        <TextBlock x:Name="LoadingTitle" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,4" Foreground="{StaticResource TextSoftBrush}"/>
        <TextBlock x:Name="LoadingDetail" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
      </StackPanel>
    </Border>

    <Border x:Name="ErrorPanel" Style="{StaticResource AlertErr}" Visibility="Collapsed">
      <StackPanel>
        <TextBlock Text="No se pudo conectar con la API" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock x:Name="ErrorDetail" TextWrapping="Wrap" Margin="0,4,0,10" Foreground="{StaticResource TextSoftBrush}"/>
        <Button Content="Reintentar" Click="Retry_Click" HorizontalAlignment="Left" Style="{StaticResource SmallButton}"/>
      </StackPanel>
    </Border>

    <StackPanel x:Name="ContentPanel" Visibility="Collapsed">
      <UniformGrid x:Name="StatGrid" Columns="3" Margin="0,0,-16,0"/>

      <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <TextBlock DockPanel.Dock="Right" Text="módulos principales" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
              <TextBlock Text="Accesos rápidos" Style="{StaticResource SectionTitle}"/>
            </DockPanel>
            <WrapPanel>
              <Button Content="Buscar negocios" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10" Click="Go_Negocios"/>
              <Button Content="Módulo CRM" Margin="0,0,10,10" Click="Go_Crm"/>
              <Button Content="Redes sociales" Margin="0,0,10,10" Click="Go_Social"/>
              <Button Content="Configuración" Margin="0,0,10,10" Click="Go_Config"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <TextBlock DockPanel.Dock="Right" Text="estado del backend" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
              <TextBlock Text="Fuentes de datos" Style="{StaticResource SectionTitle}"/>
            </DockPanel>
            <WrapPanel>
              <Border Style="{StaticResource ChipGold}" Margin="0,0,8,0"><TextBlock Text="Overture Maps"/></Border>
              <Border Style="{StaticResource ChipTeal}" Margin="0,0,8,0"><TextBlock Text="MongoDB"/></Border>
              <Border Style="{StaticResource Chip}"><TextBlock Text="DuckDB"/></Border>
            </WrapPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0">
              <Run Text="La prospección consulta lugares de Overture y los persiste en MongoDB (colección"/>
              <Run Text="BusinessList" FontFamily="{StaticResource MonoFont}"/>
              <Run Text="). Ver detalles en el módulo"/>
              <Hyperlink Foreground="{StaticResource GoldHiBrush}" Click="Go_Fuentes">Fuentes</Hyperlink><Run Text="."/>
            </TextBlock>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </StackPanel>
</UserControl>
