<UserControl x:Class="LoboEstepario.Pages.CrmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- El tema aplica el Padding dos veces (margen del host + host interno): se compensa aquí. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Padding" Value="6,5"/>
    </Style>
    <Style x:Key="CrmMultiline" TargetType="TextBox" BasedOn="{StaticResource MultilineTextBox}">
      <Setter Property="Padding" Value="6,5"/>
    </Style>
    <Style x:Key="CheckLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"/>
    </Style>

    <!-- Chip de estado anti-spam -->
    <DataTemplate x:Key="AntiSpamCell">
      <Border ToolTip="{Binding StatusTip}" HorizontalAlignment="Left">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource ChipGreen}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusKind}" Value="round">
                <Setter Property="Background" Value="{StaticResource EmberTintBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource EmberLineBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource EmberBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="cooldown">
                <Setter Property="Background" Value="{StaticResource GoldTintBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GoldLineBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource GoldHiBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding StatusLabel}" TextWrapping="Wrap" Style="{StaticResource ChipText}"/>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="CompanyCell">
      <StackPanel>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Email}" Style="{StaticResource MonoText}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CategoryCell">
      <StackPanel>
        <Border Style="{StaticResource ChipViolet}" Margin="0,0,0,3" Padding="8,1">
          <Border.Visibility>
            <Binding Path="HasCategory">
              <Binding.Converter>
                <BooleanToVisibilityConverter/>
              </Binding.Converter>
            </Binding>
          </Border.Visibility>
          <TextBlock Text="{Binding Category}" FontSize="11" TextWrapping="Wrap" Style="{StaticResource ChipText}"/>
        </Border>
        <TextBlock Text="{Binding Location}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="HistoryStatusCell">
      <StackPanel>
        <Border HorizontalAlignment="Left">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource ChipGreen}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                  <Setter Property="Background" Value="{StaticResource EmberTintBrush}"/>
                  <Setter Property="BorderBrush" Value="{StaticResource EmberLineBrush}"/>
                  <Setter Property="TextElement.Foreground" Value="{StaticResource EmberBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource ChipText}"/>
        </Border>
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,4,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="RoundChipCell">
      <Border Style="{StaticResource ChipViolet}">
        <TextBlock Text="{Binding Round}" Style="{StaticResource ChipText}"/>
      </Border>
    </DataTemplate>

    <Style x:Key="DimRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
      <Setter Property="Opacity" Value="{Binding RowOpacity}"/>
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <!-- Cabecera -->
    <StackPanel Margin="0,0,0,24">
      <TextBlock Text="CAMPAÑAS DE PROSPECCIÓN" Style="{StaticResource Eyebrow}"/>
      <TextBlock Text="CRM" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource PageLead}" Margin="0,6,0,0"
                 Text="Plantillas en MongoDB, segmentación por categoría, control de rondas de envío y reglas anti-spam para evitar saturar a las empresas."/>
    </StackPanel>

    <!-- Despertando servidor -->
    <Border x:Name="WakingBanner" Style="{StaticResource AlertInfo}" Margin="0,0,0,20" Visibility="Collapsed">
      <TextBlock x:Name="WakingText" Text="Despertando servidor…" TextWrapping="Wrap"/>
    </Border>

    <!-- Estadísticas -->
    <Grid x:Name="StatsGrid" Margin="0,0,0,20" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource StatCard}">
        <StackPanel>
          <TextBlock Text="Correos enviados" Style="{StaticResource StatLabel}"/>
          <TextBlock x:Name="SentStat" Text="0" Style="{StaticResource StatValue}" Foreground="{StaticResource TealBrush}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource StatCard}">
        <StackPanel>
          <TextBlock Text="Correos fallidos" Style="{StaticResource StatLabel}"/>
          <TextBlock x:Name="FailedStat" Text="0" Style="{StaticResource StatValue}" Foreground="{StaticResource EmberBrush}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Style="{StaticResource StatCard}">
        <StackPanel>
          <TextBlock Text="Empresas con correo" Style="{StaticResource StatLabel}"/>
          <TextBlock x:Name="WithEmailStat" Text="0" Style="{StaticResource StatValue}" Foreground="{StaticResource VioletBrush}"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- SMTP sin configurar -->
    <Border x:Name="SmtpWarning" Style="{StaticResource AlertWarn}" Margin="0,0,0,20" Visibility="Collapsed">
      <TextBlock TextWrapping="Wrap">
        <Run FontWeight="Bold" Text="Falta configurar la cuenta de correo"/>
        <Run Text=" Completa el servidor, usuario y contraseña SMTP en "/>
        <Hyperlink x:Name="ConfigLink" Foreground="{StaticResource GoldHiBrush}" Click="ConfigLink_Click">Configuración</Hyperlink>
        <Run Text=" para poder enviar campañas."/>
      </TextBlock>
    </Border>

    <!-- Reglas anti-spam y rondas -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,20" BorderBrush="{StaticResource GoldHiBrush}" BorderThickness="4,0,0,0">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="evita enviar correos repetidos o saturar a prospectos" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock Text="Reglas Anti-Spam y Control de Rondas" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="RONDA DE CAMPAÑA ACTUAL" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
            <TextBox x:Name="RoundBox" Text="Ronda 1" ToolTip="ej. Ronda 1, Ronda 2…" TextChanged="Rules_Changed"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="FILTRAR POR CATEGORÍA" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
            <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Text" SelectedValuePath="Value" SelectionChanged="CategoryCombo_SelectionChanged"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="PERIODO DE ENFRIAMIENTO" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="días" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
              <TextBox x:Name="CooldownBox" Text="30" MaxLength="3" ToolTip="De 0 a 365 días" PreviewTextInput="Digits_PreviewTextInput" TextChanged="Rules_Changed"/>
            </DockPanel>
          </StackPanel>
        </Grid>

        <WrapPanel Margin="0,16,0,0">
          <CheckBox x:Name="ExcludeRoundCheck" IsChecked="True" Margin="0,0,28,0" Checked="Rules_Changed" Unchecked="Rules_Changed">
            <TextBlock x:Name="ExcludeRoundText" Style="{StaticResource CheckLabel}" Text="Excluir empresas ya contactadas en esta ronda (Ronda 1)"/>
          </CheckBox>
          <CheckBox x:Name="CooldownCheck" IsChecked="True" Checked="Rules_Changed" Unchecked="Rules_Changed">
            <TextBlock x:Name="CooldownText" Style="{StaticResource CheckLabel}" Text="No enviar si fue contactada hace menos de 30 días"/>
          </CheckBox>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Destinatarios + Plantilla -->
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Destinatarios -->
      <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <DockPanel Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="10,0,0,0">
              <Run x:Name="FilteredCountRun" Text="0"/><Run Text=" filtrado(s) · "/><Run x:Name="SelectedCountRun" Text="0" FontWeight="Bold" Foreground="{StaticResource TextSoftBrush}"/><Run Text=" seleccionados" FontWeight="Bold" Foreground="{StaticResource TextSoftBrush}"/>
            </TextBlock>
            <TextBlock Text="Destinatarios" Style="{StaticResource SectionTitle}"/>
          </DockPanel>

          <TextBox x:Name="SearchBox" Margin="0,0,0,8" ToolTip="Buscar destinatario…" TextChanged="SearchBox_TextChanged"/>
          <WrapPanel Margin="0,0,0,12">
            <Button x:Name="EligibleButton" Style="{StaticResource PrimaryButton}" Click="SelectEligible_Click" Margin="0,0,8,0"
                    ToolTip="Selecciona solo los que no violen las reglas anti-spam" Content="Seleccionar elegibles (0)"/>
            <Button x:Name="AllButton" Style="{StaticResource SmallButton}" Click="SelectAll_Click" Margin="0,0,8,0" Content="Todos"/>
            <Button Style="{StaticResource SmallButton}" Click="DeselectAll_Click" Content="Ninguno"/>
          </WrapPanel>

          <Border x:Name="RecipientsEmpty" Style="{StaticResource EmptyState}" Padding="14,26" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock x:Name="RecipientsEmptyIcon" Text="✉" FontSize="26" HorizontalAlignment="Center" Foreground="{StaticResource FaintBrush}"/>
              <TextBlock x:Name="RecipientsEmptyTitle" Text="Sin destinatarios para este filtro" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" Margin="0,6,0,2"/>
              <TextBlock x:Name="RecipientsEmptyText" Text="Ajusta el filtro de categoría o busca más negocios en «Buscar negocios»." HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource FaintBrush}"/>
            </StackPanel>
          </Border>

          <Border x:Name="RecipientsWrap" Style="{StaticResource TableWrap}" Visibility="Collapsed">
            <DataGrid x:Name="RecipientsGrid" MaxHeight="450" IsReadOnly="False" CanUserSortColumns="False"
                      RowStyle="{StaticResource DimRow}" PreviewMouseWheel="Grid_PreviewMouseWheel">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Width="44" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTemplateColumn Header="EMPRESA / CORREO" Width="1.25*" IsReadOnly="True" CellTemplate="{StaticResource CompanyCell}"/>
                <DataGridTemplateColumn Header="CATEGORÍA" Width="1.1*" IsReadOnly="True" CellTemplate="{StaticResource CategoryCell}"/>
                <DataGridTemplateColumn Header="ANTI-SPAM" Width="128" IsReadOnly="True" CellTemplate="{StaticResource AntiSpamCell}"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </StackPanel>
      </Border>

      <!-- Plantilla y redacción -->
      <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <DockPanel Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Right" Text="gestión en MongoDB" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
            <TextBlock Text="Plantilla y Redacción" Style="{StaticResource SectionTitle}"/>
          </DockPanel>

          <TextBlock Text="CARGAR PLANTILLA GUARDADA" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
          <DockPanel>
            <Button x:Name="DeleteTemplateButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                    Click="DeleteTemplate_Click" ToolTip="Eliminar plantilla de MongoDB" Foreground="{StaticResource EmberBrush}" Content="🗑" Visibility="Collapsed"/>
            <ComboBox x:Name="TemplateCombo" DisplayMemberPath="Text" SelectedValuePath="Value" SelectionChanged="TemplateCombo_SelectionChanged"/>
          </DockPanel>

          <TextBlock Text="ASUNTO" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
          <TextBox x:Name="SubjectBox" ToolTip="ej. Oportunidad para {Empresa}"/>

          <DockPanel Margin="0,14,0,6">
            <TextBlock DockPanel.Dock="Right" Text="Acepta marcadores dinámicos" Style="{StaticResource Hint}" FontSize="11"/>
            <TextBlock Text="CUERPO DEL CORREO" Style="{StaticResource FieldLabel}"/>
          </DockPanel>
          <Grid>
            <TextBox x:Name="BodyBox" Style="{StaticResource CrmMultiline}" MinHeight="200" TextChanged="BodyBox_TextChanged"/>
            <TextBlock x:Name="BodyPlaceholder" IsHitTestVisible="False" Margin="13,10,13,0" VerticalAlignment="Top" TextWrapping="Wrap"
                       Foreground="{StaticResource FaintBrush}"
                       Text="Redacta el mensaje… Usa {Empresa}, {Categoria}, {Ubicacion} y {Remitente} para personalizar cada correo automáticamente."/>
          </Grid>

          <TextBlock Style="{StaticResource Hint}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="18">
            <Run Text="Variables: "/><Run FontWeight="Bold" Text="{}{Empresa}"/><Run Text=" nombre · "/><Run FontWeight="Bold" Text="{}{Categoria}"/><Run Text=" industria · "/><Run FontWeight="Bold" Text="{}{Ubicacion}"/><Run Text=" ciudad · "/><Run FontWeight="Bold" Text="{}{Remitente}"/><Run Text=" remitente SMTP."/>
          </TextBlock>

          <!-- Guardar / actualizar plantilla -->
          <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="10" Margin="0,14,0,0">
            <Grid>
              <DockPanel x:Name="SaveTemplateForm" Visibility="Collapsed">
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="CancelSaveTemplate_Click" Content="Cancelar"/>
                <Button x:Name="SaveNewTemplateButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="SaveNewTemplate_Click" Content="Guardar en Mongo"/>
                <TextBox x:Name="NewTemplateName" ToolTip="Nombre para la nueva plantilla…"/>
              </DockPanel>
              <WrapPanel x:Name="SaveTemplateButtons">
                <Button Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="ShowSaveTemplate_Click" Content="+ Guardar como nueva plantilla"/>
                <Button x:Name="UpdateTemplateButton" Style="{StaticResource SmallButton}" Click="UpdateTemplate_Click" Content="Sobrescribir plantilla seleccionada" Visibility="Collapsed"/>
              </WrapPanel>
            </Grid>
          </Border>

          <WrapPanel Margin="0,16,0,0">
            <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="Send_Click" Content="Enviar a 0 destinatario(s)"/>
            <Button x:Name="RefreshButton" Click="Refresh_Click" ToolTip="Recargar destinatarios e historial" Content="Recargar"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Historial -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
      <StackPanel>
        <DockPanel Margin="0,0,0,14">
          <TextBlock DockPanel.Dock="Right" Text="últimos 100 registros en MongoDB con trazabilidad de rondas" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
          <TextBlock Text="Historial de envíos" Style="{StaticResource SectionTitle}"/>
        </DockPanel>

        <Border x:Name="HistoryEmpty" Style="{StaticResource EmptyState}" Padding="14,26" Visibility="Visible">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="HistoryEmptyIcon" Text="⟳" FontSize="26" HorizontalAlignment="Center" Foreground="{StaticResource FaintBrush}"/>
            <TextBlock x:Name="HistoryEmptyTitle" Text="Cargando historial…" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" Margin="0,6,0,2"/>
            <TextBlock x:Name="HistoryEmptyText" Text="" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource FaintBrush}"/>
          </StackPanel>
        </Border>

        <Border x:Name="HistoryWrap" Style="{StaticResource TableWrap}" Visibility="Collapsed">
          <DataGrid x:Name="HistoryGrid" ScrollViewer.VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Grid_PreviewMouseWheel">
            <DataGrid.Columns>
              <DataGridTextColumn Header="EMPRESA" Binding="{Binding BusinessName}" Width="1.2*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="CORREO" Binding="{Binding ToEmail}" Width="1.3*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="FontSize" Value="12"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="ASUNTO" Binding="{Binding Subject}" Width="1.6*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="RONDA" Width="Auto" CellTemplate="{StaticResource RoundChipCell}"/>
              <DataGridTextColumn Header="FECHA" Binding="{Binding SentAt}" Width="Auto">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    <Setter Property="TextAlignment" Value="Right"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="ESTADO" Width="Auto" CellTemplate="{StaticResource HistoryStatusCell}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </StackPanel>
    </Border>

    <TextBlock x:Name="StatusText" Style="{StaticResource StatusLine}" TextWrapping="Wrap"/>
  </StackPanel>
</UserControl>
