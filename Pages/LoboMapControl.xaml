<UserControl x:Class="LoboEstepario.Pages.LoboMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Loaded="OnLoaded">
  <!-- WebView2 es un HWND sin transparencia: nada de WPF se superpone sobre él.
       El mensaje de error y el mapa se alternan (Visibility), nunca se apilan visibles a la vez. -->
  <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
          BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="1">
    <Grid>
      <wv2:WebView2CompositionControl x:Name="Web" DefaultBackgroundColor="#101418"/>
      <Border x:Name="ErrorPanel" Visibility="Collapsed" Style="{StaticResource AlertErr}" Margin="12" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="ErrorTitle" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                     Text="No se pudo cargar el mapa."/>
          <TextBlock x:Name="ErrorDetail" Margin="0,6,0,0" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap"/>
          <TextBlock x:Name="ErrorLinkRow" Margin="0,8,0,0" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap">
            <Run Text="Instala el runtime de WebView2 desde "/>
            <Hyperlink x:Name="RuntimeLink" NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/#download"
                       RequestNavigate="OnRuntimeLink">developer.microsoft.com/microsoft-edge/webview2</Hyperlink>
            <Run Text=" y vuelve a abrir la aplicación."/>
          </TextBlock>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
