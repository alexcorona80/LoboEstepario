<UserControl x:Class="LoboEstepario.Pages.FuentesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <StackPanel Margin="0,0,0,24">
      <TextBlock Text="DATOS" Style="{StaticResource Eyebrow}"/>
      <TextBlock Text="Fuentes" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource PageLead}"
                 Text="Origen de los datos de prospección: el catálogo global de lugares de Overture Maps y su almacenamiento local en MongoDB. Aquí se validan los estados de conexión."/>
    </StackPanel>

    <Border x:Name="LoadingPanel" Style="{StaticResource EmptyState}">
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="⟳" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource GoldBrush}"/>
        <TextBlock x:Name="LoadingTitle" Text="Comprobando conexiones…" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,4" Foreground="{StaticResource TextSoftBrush}"/>
        <TextBlock x:Name="LoadingDetail" Text="Consultando la API." HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <StackPanel x:Name="ContentPanel" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <Border x:Name="OvertureChip" DockPanel.Dock="Right" Style="{StaticResource ChipRed}" VerticalAlignment="Center">
                <TextBlock x:Name="OvertureChipText" Text="sin conexión"/>
              </Border>
              <TextBlock Text="Overture Maps · DuckDB" Style="{StaticResource SectionTitle}"/>
            </DockPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14">
              <Run Text="Proyección de lugares del dataset mundial"/>
              <Run Text="places" FontFamily="{StaticResource MonoFont}"/><Run Text="/"/><Run Text="place" FontFamily="{StaticResource MonoFont}"/>
              <Run Text="de Overture, consultado por la API con DuckDB."/>
            </TextBlock>
            <WrapPanel x:Name="OvertureChips"/>
            <TextBlock x:Name="DatasetPathText" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="OvertureErrorText" Style="{StaticResource Hint}" Foreground="{StaticResource EmberBrush}" Margin="0,12,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <Border x:Name="MongoChip" DockPanel.Dock="Right" Style="{StaticResource ChipTeal}" VerticalAlignment="Center">
                <TextBlock x:Name="MongoChipText" Text="persistencia"/>
              </Border>
              <TextBlock Text="MongoDB · BusinessList" Style="{StaticResource SectionTitle}"/>
            </DockPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}">
              <Run Text="Los negocios extraídos por el scrape se guardan con el id GERS de Overture como llave, de modo que un mismo lugar se actualiza en vez de duplicarse. Ahí se nutren la búsqueda, el CRM y el módulo de redes sociales. El estado de la conexión y las estadísticas se consultan desde"/>
              <Hyperlink Foreground="{StaticResource GoldHiBrush}" Click="Go_Inicio">Inicio</Hyperlink><Run Text="."/>
            </TextBlock>
            <TextBlock x:Name="MongoStatsText" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <Button Content="Volver a comprobar" Click="Recheck_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
    </StackPanel>
  </StackPanel>
</UserControl>
