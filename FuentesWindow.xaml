<Window x:Class="LoboEstepario.FuentesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lobo Estepario · Fuentes" Height="720" Width="1000" MinHeight="560" MinWidth="860" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource NightBrush}" Foreground="{StaticResource TextBrush}">
<Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="31"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="{StaticResource NightRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><DockPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0"><TextBlock Text="◉" Foreground="{StaticResource GoldBrush}" FontSize="17"/><TextBlock Text="LOBO ESTEPARIO" Foreground="{StaticResource GoldBrush}" FontSize="10" Margin="10,0"/><Border Width="1" Height="14" Background="{StaticResource LineBrush}" Margin="4,0,10,0"/><TextBlock Text="FUENTES · DATOS" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="—" Click="Minimize_Click" Width="46" BorderThickness="0" Padding="0"/><Button Content="×" Click="Close_Click" Width="46" BorderThickness="0" Padding="0"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource EmberBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Button.Style></Button></StackPanel></DockPanel></Border>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="1080" Margin="36,26,36,34" HorizontalAlignment="Center">
<StackPanel><TextBlock Text="DATOS" Foreground="{StaticResource GoldBrush}" FontSize="10"/><TextBlock FontFamily="Georgia" FontSize="32" Margin="0,10,0,0"><Run Text="Origen de los "/><Run Foreground="{StaticResource GoldLightBrush}" FontStyle="Italic" Text="datos."/></TextBlock><Border Width="64" Height="2" Background="{StaticResource GoldBrush}" HorizontalAlignment="Left" Margin="0,16,0,0"/><TextBlock Text="El catálogo global de lugares de Overture Maps y su almacenamiento local en MongoDB. Aquí se validan los estados de conexión." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,14,0,24"/></StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="22,18"><StackPanel>
<DockPanel><TextBlock Text="OVERTURE MAPS · DUCKDB" Foreground="{StaticResource GoldBrush}" FontSize="10" VerticalAlignment="Center"/><Border x:Name="OvertureChip" DockPanel.Dock="Right" Background="{StaticResource NightRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,5"><TextBlock x:Name="OvertureChipText" Text="Comprobando…" Foreground="{StaticResource MutedBrush}" FontSize="10"/></Border></DockPanel>
<TextBlock Text="Prospección de lugares" FontFamily="Georgia" FontSize="22" Margin="0,8,0,14"/>
<TextBlock Text="La API consulta el dataset mundial places/place de Overture con DuckDB (HTTPFS + S3) y devuelve hasta 100 lugares por ejecución." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
<TextBlock x:Name="OvertureMetadataText" Text="" Visibility="Collapsed" Foreground="{StaticResource GoldLightBrush}" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"/>
<TextBlock x:Name="DatasetPathText" Text="" Visibility="Collapsed" Foreground="{StaticResource FaintBrush}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" FontFamily="Consolas"/>
<TextBlock x:Name="OvertureErrorText" Text="" Visibility="Collapsed" Foreground="{StaticResource EmberBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
</StackPanel></Border>
<Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="22,18"><StackPanel>
<DockPanel><TextBlock Text="MONGODB · BUSINESSLIST" Foreground="{StaticResource GoldBrush}" FontSize="10" VerticalAlignment="Center"/><Border x:Name="MongoChip" DockPanel.Dock="Right" Background="{StaticResource NightRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,5"><TextBlock x:Name="MongoChipText" Text="Comprobando…" Foreground="{StaticResource MutedBrush}" FontSize="10"/></Border></DockPanel>
<TextBlock Text="Persistencia local" FontFamily="Georgia" FontSize="22" Margin="0,8,0,14"/>
<TextBlock Text="Cada scrape guarda los negocios con el id GERS de Overture como llave, de modo que un lugar se actualiza en vez de duplicarse. De ahí se nutren la búsqueda, el CRM y las redes sociales." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
<TextBlock x:Name="MongoStatsText" Text="…" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,14,0,0" TextWrapping="Wrap"/>
<TextBlock x:Name="MongoErrorText" Text="" Visibility="Collapsed" Foreground="{StaticResource EmberBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
</StackPanel></Border>
</Grid>
<Button x:Name="RecheckButton" Content="VOLVER A COMPROBAR" Click="Recheck_Click" HorizontalAlignment="Left" Margin="0,22,0,0" Padding="16,10"/>
</StackPanel></ScrollViewer>
<Border Grid.Row="2" Background="{StaticResource NightRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="14,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource GoldBrush}" Margin="0,0,8,0"/><TextBlock Text="API LOCAL" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="Comprobando las conexiones…" Foreground="{StaticResource FaintBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel></Border>
</Grid></Border>
</Window>